{
  "name": "origem-backend",
  "version": "1.0.0",
  "private": true,
  "description": "API do Origem — backend real da U2 (contrato em docs/api.md) e rotas de laboratório do FCCPD U1 (concorrência no checkout + fila assíncrona).",
  "type": "module",
  "scripts": {
    "api": "node src/server.js",
    "worker": "node src/worker.js",
    "test": "node --test testes/api/",
    "postinstall": "prisma generate",
    "prisma:pull": "prisma db pull && prisma generate",
    "teste:concorrencia": "node testes/teste-concorrencia.js",
    "teste:deadlock": "node testes/teste-deadlock.js",
    "teste:fila": "node testes/teste-fila.js",
    "evidencias": "bash testes/gerar-evidencias.sh"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "prisma": "6.19.3",
    "supertest": "^7.1.0"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "@prisma/engines@6.19.3": true
  }
}
