# Variáveis de ambiente do backend do Origem.
# Todas têm valor padrão no código — este arquivo é documentação.
# Para usar: copie para .env e ajuste (ou exporte no terminal antes de subir a API).

# Endereço do PostgreSQL. A porta 5434 é a definida em docker-compose.yml.
# Usado pela API, pelo worker e pelo Prisma. Para atualizar o schema do Prisma
# depois de mudar o SQL: DATABASE_URL=... npm run prisma:pull
DATABASE_URL=postgres://origem:origem@localhost:5434/origem

# Porta da API HTTP (o frontend Next.js usa a 3000, por isso não usamos ela).
PORT=3333

# [U2] Origens que o navegador pode usar para chamar a API (CORS), separadas
# por vírgula. O frontend Next.js roda na 3000; em produção, some a URL da Vercel.
CORS_ORIGEM=http://localhost:3000

# [U2] Segredo que assina os tokens de login (JWT). Quem o conhece consegue
# fabricar um token de administrador: em produção é OBRIGATÓRIO e deve ser
# longo e aleatório (ex.: openssl rand -hex 32). Sem ele, a API usa um valor
# de desenvolvimento e se recusa a subir com NODE_ENV=production.
# JWT_SECRET=troque-por-um-valor-aleatorio

# [U2] Por quanto tempo o login vale (formato: 30m, 8h, 7d).
JWT_VALIDADE=8h

# Tamanho do pool de conexões: quantos checkouts conseguem falar com o banco
# ao mesmo tempo. As demais requisições esperam a vez.
PG_POOL_MAX=10

# Quando "true", a rota POST /pedidos passa a usar o checkout INGÊNUO
# (com race condition). Serve para o teste comparativo da Etapa 3.
# A rota POST /pedidos-naive usa o ingênuo sempre, independente desta flag.
NAIVE_CHECKOUT=false

# ----------------------------------------------------------------------------
# [FCCPD — Etapa 2] Fila assíncrona e worker
# ----------------------------------------------------------------------------

# Quantos jobs o worker reserva por rodada.
LOTE=5

# Pausa entre consultas à fila quando ela está vazia (ms).
INTERVALO_MS=500

# Espera da 1ª nova tentativa (ms). Dobra a cada falha: 2s, 4s, 8s, 16s.
BACKOFF_BASE_MS=2000

# Tempo sem notícia após o qual um job preso em 'processando' é considerado
# órfão (o worker que o pegou morreu) e volta para a fila. Precisa ser MAIOR
# que a tarefa mais lenta.
TIMEOUT_JOB_MS=30000

# Probabilidade (0 a 1) de falha ARTIFICIAL nas tarefas. Existe só para as
# evidências: sem falha não há como demonstrar retry, backoff e dead-letter.
# Ex.: TAXA_FALHA=0.3 npm run worker
TAXA_FALHA=0
